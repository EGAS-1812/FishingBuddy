@model FishingBuddy.Models.Fish
@{
    ViewData["Title"] = "Obriši vrstu ribe";
    ViewData["BreadcrumbItems"] = new List<(string, string?)>
    {
        ("Početna", "/"),
        ("Vrste riba", "/Fish"),
        ("Upravljanje", "/Fish/Manage"),
        ("Obriši", null)
    };
}

<section class="card shadow-sm border-0">
    <div class="card-body">
        @await Html.PartialAsync("_CrudOptionSwitcher", null, new ViewDataDictionary(ViewData)
        {
            ["CrudController"] = "Fish",
            ["CrudMode"] = "delete"
        })

        <h1 class="h2 mb-1 text-danger">Potvrda brisanja</h1>
        <p class="text-muted mb-4">Jeste li sigurni da želite obrisati ovu vrstu ribe?</p>

        <dl class="row">
            <dt class="col-sm-3">Naziv vrste</dt>
            <dd class="col-sm-9">@Model.SpeciesName</dd>

            <dt class="col-sm-3">Sezona lova</dt>
            <dd class="col-sm-9">@Model.CatchSeason.GetDisplayName()</dd>

            <dt class="col-sm-3">Boja mesa</dt>
            <dd class="col-sm-9">@Model.FleshColor.GetDisplayName()</dd>
        </dl>

        <form asp-action="Delete" method="post">
            <input asp-for="FishID" type="hidden" />
            @Html.AntiForgeryToken()
            <div class="d-flex flex-wrap gap-2 fb-crud-action-row">
                <button type="submit" class="btn btn-danger">Obriši</button>
                <a class="btn btn-outline-secondary" asp-controller="Fish" asp-action="Manage">Odustani</a>
            </div>
        </form>
    </div>
</section>
