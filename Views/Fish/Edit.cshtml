@model FishingBuddy.Models.Fish
@using System.Linq
@{
    var baitOptions = ViewBag.Baits as IEnumerable<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem> ?? Enumerable.Empty<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>();
    var techniqueOptions = ViewBag.Techniques as IEnumerable<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem> ?? Enumerable.Empty<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>();
    var selectedBaitLabel = baitOptions.FirstOrDefault(x => x.Value == Model.FavouriteBaitID.ToString())?.Text ?? string.Empty;
    var selectedTechniqueLabel = techniqueOptions.FirstOrDefault(x => x.Value == Model.PreferredMethodID.ToString())?.Text ?? string.Empty;

    ViewData["Title"] = "Uredi vrstu ribe";
    ViewData["BreadcrumbItems"] = new List<(string, string?)>
    {
        ("Početna", "/"),
        ("Vrste riba", "/Fish"),
        ("Upravljanje", "/Fish/Manage"),
        ("Uredi vrstu ribe", null)
    };
}

<section class="card shadow-sm border-0">
    <div class="card-body">
        <div class="mb-4">
            <h1 class="h2 mb-1">Uredi vrstu ribe</h1>
            <p class="text-muted mb-0">Ažurirajte podatke o vrsti ribe.</p>
        </div>

        <form asp-action="Edit" method="post" novalidate>
            <input asp-for="FishID" type="hidden" />
            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 mb-4" role="alert"></div>

            <div class="row g-3">
                <div class="col-12 col-md-6">
                    <label asp-for="SpeciesName" class="form-label">Naziv vrste</label>
                    <input asp-for="SpeciesName" class="form-control" />
                    <span asp-validation-for="SpeciesName" class="text-danger small"></span>
                </div>

                <div class="col-12 col-md-6">
                    <label asp-for="CatchSeason" class="form-label">Sezona lova</label>
                    <select asp-for="CatchSeason" asp-items="Html.GetEnumSelectList<FishingBuddy.Models.Season>()" class="form-select">
                        <option value="">-- Odaberite sezonu --</option>
                    </select>
                    <span asp-validation-for="CatchSeason" class="text-danger small"></span>
                </div>

                <div class="col-12 col-md-6">
                    <label asp-for="FleshColor" class="form-label">Boja mesa</label>
                    <select asp-for="FleshColor" asp-items="Html.GetEnumSelectList<FishingBuddy.Models.FishFlesh>()" class="form-select">
                        <option value="">-- Odaberite boju --</option>
                    </select>
                    <span asp-validation-for="FleshColor" class="text-danger small"></span>
                </div>

                <div class="col-12 col-md-6">
                    @await Html.PartialAsync("_AutocompleteDropdown", null, new ViewDataDictionary(ViewData)
                    {
                        ["FieldName"] = nameof(Model.FavouriteBaitID),
                        ["FieldId"] = nameof(Model.FavouriteBaitID),
                        ["Label"] = "Omiljeni mamac",
                        ["Endpoint"] = Url.Action("Autocomplete", "Bait"),
                        ["SelectedValue"] = Model.FavouriteBaitID.ToString(),
                        ["SelectedLabel"] = selectedBaitLabel,
                        ["Placeholder"] = "Upisite naziv mamca"
                    })
                    <span asp-validation-for="FavouriteBaitID" class="text-danger small"></span>
                </div>

                <div class="col-12 col-md-6">
                    @await Html.PartialAsync("_AutocompleteDropdown", null, new ViewDataDictionary(ViewData)
                    {
                        ["FieldName"] = nameof(Model.PreferredMethodID),
                        ["FieldId"] = nameof(Model.PreferredMethodID),
                        ["Label"] = "Preferirana tehnika",
                        ["Endpoint"] = Url.Action("Autocomplete", "Technique"),
                        ["SelectedValue"] = Model.PreferredMethodID.ToString(),
                        ["SelectedLabel"] = selectedTechniqueLabel,
                        ["Placeholder"] = "Upisite naziv tehnike"
                    })
                    <span asp-validation-for="PreferredMethodID" class="text-danger small"></span>
                </div>
            </div>

            <div class="d-flex flex-wrap gap-2 mt-4">
                <button type="submit" class="btn btn-primary">Spremi promjene</button>
                <a class="btn btn-outline-secondary" asp-controller="Fish" asp-action="Manage">Odustani</a>
            </div>
        </form>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
