@model FishingBuddy.Models.Fish
@{
    ViewData["Title"] = "Nova vrsta ribe";
    ViewData["BreadcrumbItems"] = new List<(string, string?)>
    {
        ("Početna", "/"),
        ("Vrste riba", "/Fish"),
        ("Upravljanje", "/Fish/Manage"),
        ("Nova vrsta ribe", null)
    };
}

<section class="card shadow-sm border-0">
    <div class="card-body">
        <div class="mb-4">
            <h1 class="h2 mb-1">Nova vrsta ribe</h1>
            <p class="text-muted mb-0">Dodajte novu vrstu ribe sa sezonom, bojom mesa i preferiranom opremom.</p>
        </div>

        <form asp-action="Create" method="post" novalidate>
            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 mb-4" role="alert"></div>

            <div class="row g-3">
                <div class="col-12 col-md-6">
                    <label asp-for="SpeciesName" class="form-label">Naziv vrste</label>
                    <input asp-for="SpeciesName" class="form-control" />
                    <span asp-validation-for="SpeciesName" class="text-danger small"></span>
                </div>

                <div class="col-12 col-md-6">
                    <label asp-for="CatchSeason" class="form-label">Sezona lova</label>
                    <select asp-for="CatchSeason" class="form-select">
                        <option value="">-- Odaberite sezonu --</option>
                        <option value="Spring">Proljeće</option>
                        <option value="Summer">Ljeto</option>
                        <option value="Autumn">Jesen</option>
                        <option value="Winter">Zima</option>
                    </select>
                    <span asp-validation-for="CatchSeason" class="text-danger small"></span>
                </div>

                <div class="col-12 col-md-6">
                    <label asp-for="FleshColor" class="form-label">Boja mesa</label>
                    <select asp-for="FleshColor" class="form-select">
                        <option value="">-- Odaberite boju --</option>
                        <option value="Blue">Plavo</option>
                        <option value="Red">Crveno</option>
                        <option value="White">Bijelo</option>
                    </select>
                    <span asp-validation-for="FleshColor" class="text-danger small"></span>
                </div>

                <div class="col-12 col-md-6">
                    <label asp-for="FavouriteBaitID" class="form-label">Omiljeni mamac</label>
                    <select asp-for="FavouriteBaitID" asp-items="ViewBag.Baits" class="form-select">
                        <option value="">-- Odaberite mamac --</option>
                    </select>
                    <span asp-validation-for="FavouriteBaitID" class="text-danger small"></span>
                </div>

                <div class="col-12 col-md-6">
                    <label asp-for="PreferredMethodID" class="form-label">Preferirana tehnika</label>
                    <select asp-for="PreferredMethodID" asp-items="ViewBag.Techniques" class="form-select">
                        <option value="">-- Odaberite tehniku --</option>
                    </select>
                    <span asp-validation-for="PreferredMethodID" class="text-danger small"></span>
                </div>
            </div>

            <div class="d-flex flex-wrap gap-2 mt-4">
                <button type="submit" class="btn btn-primary">Stvori vrstu</button>
                <a class="btn btn-outline-secondary" asp-controller="Fish" asp-action="Manage">Odustani</a>
            </div>
        </form>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
