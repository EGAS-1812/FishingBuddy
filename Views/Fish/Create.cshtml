@model FishingBuddy.Models.Fish
@{
    ViewData["Title"] = "Nova vrsta ribe";
    var baitOptions = ViewBag.Baits as IEnumerable<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem> ?? Enumerable.Empty<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>();
    var preferredMethodLabel = ViewData["PreferredMethodLabel"] as string ?? string.Empty;
    ViewData["BreadcrumbItems"] = new List<(string, string?)>
    {
        ("Početna", "/"),
        ("Vrste riba", "/Fish"),
        ("Upravljanje", "/Fish/Manage"),
        ("Nova vrsta ribe", null)
    };
}

<section class="card shadow-sm border-0">
    <div class="card-body">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-3 fb-page-header">
            <div class="d-none d-md-block">
                <h1 class="h2 mb-1">Nova vrsta ribe</h1>
                <p class="text-muted mb-0">Dodajte novu vrstu ribe sa sezonom, bojom mesa i odabirom mamca i tehnike iz popisa.</p>
            </div>
            <div class="fb-page-mobile-titlebar d-md-none">
                <h1 class="h2 mb-0">Nova vrsta ribe</h1>
            </div>
            @await Html.PartialAsync("_CrudOptionSwitcher", null, new ViewDataDictionary(ViewData)
            {
                ["CrudController"] = "Fish",
                ["CrudMode"] = "create"
            })
        </div>

        <form asp-action="Create" method="post" novalidate>
            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 mb-4" role="alert"></div>

            <div class="row g-3">
                <div class="col-12 col-md-6">
                    <label asp-for="SpeciesName" class="form-label">Naziv vrste</label>
                    <input asp-for="SpeciesName" class="form-control" />
                    <span asp-validation-for="SpeciesName" class="text-danger small"></span>
                </div>

                <div class="col-12 col-md-6">
                    <label asp-for="CatchSeason" class="form-label">Sezona lova</label>
                    <select asp-for="CatchSeason" asp-items="Html.GetEnumSelectList<FishingBuddy.Models.Season>()" class="form-select">
                        <option value="">-- Odaberite sezonu --</option>
                    </select>
                    <span asp-validation-for="CatchSeason" class="text-danger small"></span>
                </div>

                <div class="col-12 col-md-6">
                    <label asp-for="FleshColor" class="form-label">Boja mesa</label>
                    <select asp-for="FleshColor" asp-items="Html.GetEnumSelectList<FishingBuddy.Models.FishFlesh>()" class="form-select">
                        <option value="">-- Odaberite boju --</option>
                    </select>
                    <span asp-validation-for="FleshColor" class="text-danger small"></span>
                </div>

                <div class="col-12 col-md-6">
                    <label asp-for="FavouriteBaitID" class="form-label">Omiljeni mamac</label>
                    <select asp-for="FavouriteBaitID" asp-items="baitOptions" class="form-select">
                        <option value="">-- Odaberite mamac --</option>
                    </select>
                    <span asp-validation-for="FavouriteBaitID" class="text-danger small"></span>
                </div>

                <div class="col-12 col-md-6">
                    @await Html.PartialAsync("_AutocompleteDropdown", null, new ViewDataDictionary(ViewData)
                    {
                        ["FieldName"] = nameof(Model.PreferredMethodID),
                        ["FieldId"] = nameof(Model.PreferredMethodID),
                        ["Label"] = "Preferirana tehnika",
                        ["Endpoint"] = Url.Action("Autocomplete", "Technique"),
                        ["SelectedValue"] = Model.PreferredMethodID > 0 ? Model.PreferredMethodID.ToString() : string.Empty,
                        ["SelectedLabel"] = preferredMethodLabel,
                        ["Placeholder"] = "Upisite naziv tehnike"
                    })
                    <span asp-validation-for="PreferredMethodID" class="text-danger small"></span>
                </div>

                <div class="col-12 mt-3">
                    <h2 class="h6 fw-semibold mb-3 text-muted text-uppercase" style="font-size:.72rem;letter-spacing:.08em;">Oprema</h2>
                    <div class="row g-3">
                        <div class="col-12 col-md-4">
                            <label asp-for="Equipment.FReel.Type" class="form-label">Tip role</label>
                            <select asp-for="Equipment.FReel.Type"
                                    asp-items="Html.GetEnumSelectList<FishingBuddy.Models.FReelType>()"
                                    class="form-select">
                            </select>
                        </div>
                        <div class="col-12 col-md-4">
                            <label asp-for="Equipment.FReel.Size" class="form-label">Veličina role</label>
                            <input asp-for="Equipment.FReel.Size" class="form-control" type="number" min="500" max="20000" />
                        </div>
                        <div class="col-12 col-md-4">
                            <label asp-for="Equipment.FRod.Action" class="form-label">Akcija štapa</label>
                            <select asp-for="Equipment.FRod.Action"
                                    asp-items="Html.GetEnumSelectList<FishingBuddy.Models.FRodAction>()"
                                    class="form-select">
                            </select>
                        </div>
                        <div class="col-12 col-md-4">
                            <label asp-for="Equipment.FRod.LengthMeters" class="form-label">Dužina štapa (m)</label>
                            <input asp-for="Equipment.FRod.LengthMeters" class="form-control" type="number" step="0.1" min="1" max="5" />
                        </div>
                        <div class="col-12 col-md-4">
                            <label asp-for="Equipment.FRod.MinWeightRatingGrams" class="form-label">Min. težina (g)</label>
                            <input asp-for="Equipment.FRod.MinWeightRatingGrams" class="form-control" type="number" min="1" />
                        </div>
                        <div class="col-12 col-md-4">
                            <label asp-for="Equipment.FRod.MaxWeightRatingGrams" class="form-label">Max. težina (g)</label>
                            <input asp-for="Equipment.FRod.MaxWeightRatingGrams" class="form-control" type="number" min="1" />
                        </div>
                        <div class="col-12 col-md-4">
                            <label asp-for="Equipment.FLine.Type" class="form-label">Tip najlona</label>
                            <select asp-for="Equipment.FLine.Type"
                                    asp-items="Html.GetEnumSelectList<FishingBuddy.Models.FLineType>()"
                                    class="form-select">
                            </select>
                        </div>
                        <div class="col-12 col-md-4">
                            <label asp-for="Equipment.FLine.ThicknessMm" class="form-label">Debljina najlona (mm)</label>
                            <input asp-for="Equipment.FLine.ThicknessMm" class="form-control" type="number" step="0.01" min="0.05" max="1" />
                        </div>
                    </div>
                </div>
            </div>

            <div class="d-flex flex-wrap gap-2 mt-4 fb-crud-action-row">
                <button type="submit" class="btn btn-primary">Stvori vrstu</button>
                <a class="btn btn-outline-secondary" asp-controller="Fish" asp-action="Manage">Odustani</a>
            </div>
        </form>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
