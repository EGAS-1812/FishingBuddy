@model IReadOnlyList<FishingBuddy.Models.Fish>
@{
    var isManage = (ViewData["ManageMode"] as bool?) ?? string.Equals(Context.Request.Query["mode"], "manage", StringComparison.OrdinalIgnoreCase);
}

@if (Model.Count == 0)
{
    <tr>
        <td colspan="@(isManage ? 4 : 3)" class="text-center py-4 text-muted">Nema trazenih vrsta riba.</td>
    </tr>
}
else
{
    foreach (var fish in Model)
    {
        <tr>
            <td class="fw-semibold">@fish.SpeciesName</td>
            @if (isManage)
            {
                <td>@fish.CatchSeason.GetDisplayName()</td>
                <td>@fish.FleshColor.GetDisplayName()</td>
                <td class="text-end">
                    <div class="d-inline-flex gap-2">
                        <a class="btn btn-sm btn-outline-secondary" asp-controller="Fish" asp-action="Edit" asp-route-id="@fish.FishID">Uredi</a>
                        <a class="btn btn-sm btn-outline-danger" asp-controller="Fish" asp-action="Delete" asp-route-id="@fish.FishID">Obrisi</a>
                    </div>
                </td>
            }
            else
            {
                <td>@(fish.PreferredMethod?.TechniqueName ?? "-")</td>
                <td class="text-end">
                    <a class="btn btn-sm btn-outline-primary" asp-controller="Fish" asp-action="Details" asp-route-id="@fish.FishID">Detalji</a>
                </td>
            }
        </tr>
    }
}
