@model IReadOnlyList<FishingBuddy.Models.FishingSpot>
@{
    ViewData["Title"] = "Upravljanje ribolovnim mjestima";
    ViewData["BreadcrumbItems"] = new List<(string, string?)>
    {
        ("Početna", "/"),
        ("Ribolovna mjesta", "/FishingSpot"),
        ("Upravljanje", null)
    };
}

<section class="card shadow-sm border-0">
    <div class="card-body">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-3">
            <div>
                <h1 class="h2 mb-1">Upravljanje ribolovnim mjestima</h1>
                <p class="text-muted mb-0">Administrirajte ribolovna mjesta, regije i dostupnost infrastrukture.</p>
            </div>
            <div class="d-flex align-items-center gap-2">
                <span class="badge bg-primary">@Model.Count mjesta</span>
                <a class="btn btn-primary btn-sm" asp-controller="FishingSpot" asp-action="Create">Dodaj mjesto</a>
                <div class="dropdown">
                    <button class="btn btn-sm btn-outline-dark dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">CRUD</button>
                    <ul class="dropdown-menu">
                        <li><a class="dropdown-item" asp-controller="FishingSpot" asp-action="Create"><span class="badge bg-success rounded-pill me-2">Create</span></a></li>
                        <li><a class="dropdown-item" asp-controller="FishingSpot" asp-action="Manage"><span class="badge bg-warning text-dark rounded-pill me-2">Update</span></a></li>
                        <li><a class="dropdown-item" asp-controller="FishingSpot" asp-action="Manage"><span class="badge bg-danger rounded-pill me-2">Delete</span></a></li>
                    </ul>
                </div>
            </div>
        </div>

        <div class="table-responsive">
            <table class="table table-hover table-bordered table-sm align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th scope="col">Naziv mjesta</th>
                        <th scope="col">Regija</th>
                        <th scope="col" class="text-center">Mol/Pristanište</th>
                        <th scope="col" class="text-center">Pristup brodom</th>
                        <th scope="col" class="text-end">Radnje</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Count == 0)
                    {
                        <tr>
                            <td colspan="5" class="text-center py-4 text-muted">Nema unesenih ribolovnih mjesta.</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var spot in Model)
                        {
                            <tr>
                                <td class="fw-semibold">@spot.SpotName</td>
                                <td>@spot.Region</td>
                                <td class="text-center">@(spot.HasPiers ? "✓" : "✗")</td>
                                <td class="text-center">@(spot.BoatAccess ? "✓" : "✗")</td>
                                <td class="text-end">
                                    <div class="d-inline-flex gap-2">
                                        <a class="btn btn-sm btn-outline-secondary" asp-controller="FishingSpot" asp-action="Edit" asp-route-id="@spot.SpotID">Uredi</a>
                                        <a class="btn btn-sm btn-outline-danger" asp-controller="FishingSpot" asp-action="Delete" asp-route-id="@spot.SpotID">Obriši</a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</section>
