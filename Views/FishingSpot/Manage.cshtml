@model IReadOnlyList<FishingBuddy.Models.FishingSpot>
@{
    ViewData["Title"] = "Upravljanje ribolovnim mjestima";
    ViewData["BreadcrumbItems"] = new List<(string, string?)>
    {
        ("Početna", "/"),
        ("Ribolovna mjesta", "/FishingSpot"),
        ("Upravljanje", null)
    };
}

<section class="card shadow-sm border-0">
    <div class="card-body">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-3">
            <div>
                <h1 class="h2 mb-1">Upravljanje ribolovnim mjestima</h1>
                <p class="text-muted mb-0">Administrirajte ribolovna mjesta, regije i dostupnost infrastrukture.</p>
            </div>
            <div class="d-flex align-items-center gap-2">
                <span class="badge bg-primary">@Model.Count mjesta</span>
                <div class="dropdown fb-crud-dropdown">
                    <button class="btn btn-outline-dark dropdown-toggle fb-crud-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">CRUD</button>
                    <ul class="dropdown-menu fb-crud-menu">
                        <li><a class="dropdown-item fb-crud-item fb-crud-item--create" asp-controller="FishingSpot" asp-action="Create"><span class="badge bg-success rounded-pill me-2">Create</span></a></li>
                        <li><a class="dropdown-item fb-crud-item fb-crud-item--update" asp-controller="FishingSpot" asp-action="Manage"><span class="badge bg-warning text-dark rounded-pill me-2">Update</span></a></li>
                        <li><a class="dropdown-item fb-crud-item fb-crud-item--delete" asp-controller="FishingSpot" asp-action="Manage"><span class="badge bg-danger rounded-pill me-2">Delete</span></a></li>
                    </ul>
                </div>
            </div>
        </div>

        <div class="fb-list-search"
             data-ajax-search
             data-search-endpoint="@Url.Action("Search", "FishingSpot")"
             data-search-mode="manage"
             data-empty-colspan="5"
             data-empty-message="Nema trazenih ribolovnih mjesta.">
            <label class="form-label" for="spotManageSearch">Pretrazi ribolovna mjesta</label>
            <input id="spotManageSearch" type="search" class="form-control" placeholder="Naziv, regija, mol ili brod..." data-search-input autocomplete="off" />
            <div class="form-text fb-search-status" data-search-status aria-live="polite">Prikaz svih zapisa.</div>

            <div class="table-responsive">
            <table class="table table-hover table-bordered table-sm align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th scope="col">Naziv mjesta</th>
                        <th scope="col">Regija</th>
                        <th scope="col" class="text-center">Mol/Pristanište</th>
                        <th scope="col" class="text-center">Pristup brodom</th>
                        <th scope="col" class="text-end">Radnje</th>
                    </tr>
                </thead>
                <tbody data-search-target>
                    @await Html.PartialAsync("_FishingSpotRows", Model, new ViewDataDictionary(ViewData) { ["ManageMode"] = true })
                </tbody>
            </table>
        </div>
        </div>
    </div>
</section>


