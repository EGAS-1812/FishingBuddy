@model FishingBuddy.Models.Technique
@{
    ViewData["Title"] = "Nova tehnika";
    ViewData["BreadcrumbItems"] = new List<(string, string?)>
    {
        ("Početna", "/"),
        ("Tehnike", "/Technique"),
        ("Upravljanje", "/Technique/Manage"),
        ("Nova tehnika", null)
    };
}

<section class="card shadow-sm border-0">
    <div class="card-body">
        <div class="mb-4">
            <h1 class="h2 mb-1">Nova tehnika</h1>
            <p class="text-muted mb-0">Dodajte novu tehniku s kratkim opisom i poveznicom na video vodic.</p>
        </div>

        <form asp-action="Create" method="post" novalidate>
            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 mb-4" role="alert"></div>

            <div class="row g-3">
                <div class="col-12">
                    <label asp-for="TechniqueName" class="form-label">Naziv tehnike</label>
                    <input asp-for="TechniqueName" class="form-control" />
                    <span asp-validation-for="TechniqueName" class="text-danger small"></span>
                </div>

                <div class="col-12">
                    <label asp-for="PerformanceNote" class="form-label">Kako se izvodi</label>
                    <textarea asp-for="PerformanceNote" class="form-control" rows="4"></textarea>
                    <span asp-validation-for="PerformanceNote" class="text-danger small"></span>
                </div>

                <div class="col-12">
                    <label asp-for="TutorialUrl" class="form-label">Poveznica na tutorial</label>
                    <input asp-for="TutorialUrl" class="form-control" type="url" placeholder="https://..." />
                    <span asp-validation-for="TutorialUrl" class="text-danger small"></span>
                </div>
            </div>

            <div class="d-flex flex-wrap gap-2 mt-4">
                <button type="submit" class="btn btn-primary">Stvori tehniku</button>
                <a class="btn btn-outline-secondary" asp-controller="Technique" asp-action="Manage">Odustani</a>
            </div>
        </form>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}