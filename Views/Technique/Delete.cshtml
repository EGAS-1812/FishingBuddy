@model FishingBuddy.Models.Technique
@{
    ViewData["Title"] = "Obriši tehniku";
    ViewData["BreadcrumbItems"] = new List<(string, string?)>
    {
        ("Početna", "/"),
        ("Tehnike", "/Technique"),
        ("Upravljanje", "/Technique/Manage"),
        ("Obriši", null)
    };
}

<section class="card shadow-sm border-0">
    <div class="card-body">
        @await Html.PartialAsync("_CrudOptionSwitcher", null, new ViewDataDictionary(ViewData)
        {
            ["CrudController"] = "Technique",
            ["CrudMode"] = "delete"
        })

        <h1 class="h2 mb-1 text-danger">Potvrda brisanja</h1>
        <p class="text-muted mb-4">Jeste li sigurni da želite obrisati ovu tehniku?</p>

        <dl class="row">
            <dt class="col-sm-3">Naziv tehnike</dt>
            <dd class="col-sm-9">@Model.TechniqueName</dd>

            @if (!string.IsNullOrWhiteSpace(Model.PerformanceNote))
            {
                <dt class="col-sm-3">Kako se izvodi</dt>
                <dd class="col-sm-9">@Model.PerformanceNote</dd>
            }

            @if (!string.IsNullOrWhiteSpace(Model.TutorialUrl))
            {
                <dt class="col-sm-3">Tutorial</dt>
                <dd class="col-sm-9"><a href="@Model.TutorialUrl" target="_blank" rel="noopener noreferrer">@Model.TutorialUrl</a></dd>
            }
        </dl>

        <form asp-action="Delete" method="post">
            <input asp-for="TechniqueID" type="hidden" />
            @Html.AntiForgeryToken()
            <div class="d-flex flex-wrap gap-2 fb-crud-action-row">
                <button type="submit" class="btn btn-danger">Obriši</button>
                <a class="btn btn-outline-secondary" asp-controller="Technique" asp-action="Manage">Odustani</a>
            </div>
        </form>
    </div>
</section>
