@model IReadOnlyList<FishingBuddy.Models.Technique>
@{
    ViewData["Title"] = "Tehnike";
    ViewData["BreadcrumbItems"] = new List<(string, string?)>
    {
        ("Početna", "/")
    };
}

<section class="card shadow-sm border-0">
    <div class="card-body">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h1 class="h2 mb-0">Tehnike</h1>
            <div class="d-flex align-items-center gap-2">
                <div class="dropdown">
                    <button class="btn btn-sm btn-outline-dark dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">CRUD</button>
                    <ul class="dropdown-menu">
                        <li><a class="dropdown-item" asp-controller="Technique" asp-action="Create"><span class="badge bg-success rounded-pill me-2">Create</span></a></li>
                        <li><a class="dropdown-item" asp-controller="Technique" asp-action="Manage"><span class="badge bg-warning text-dark rounded-pill me-2">Update</span></a></li>
                        <li><a class="dropdown-item" asp-controller="Technique" asp-action="Manage"><span class="badge bg-danger rounded-pill me-2">Delete</span></a></li>
                    </ul>
                </div>
                <span class="badge bg-primary">@Model.Count tehnika</span>
            </div>
        </div>

        <div class="table-responsive">
            <table class="table table-hover table-bordered table-sm align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th scope="col">Naziv</th>
                        <th scope="col" class="text-end">Radnje</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var technique in Model)
                    {
                        <tr>
                            <td>@technique.TechniqueName</td>
                            <td class="text-end">
                                <a class="btn btn-sm btn-outline-primary" asp-controller="Technique" asp-action="Details" asp-route-id="@technique.TechniqueID">Detalji</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</section>