@model IReadOnlyList<FishingBuddy.Models.User>
@{
    var requestMode = Context.Request.Query["mode"].ToString();
    var isManage = (ViewData["ManageMode"] as bool?) ?? !string.Equals(requestMode, "index", StringComparison.OrdinalIgnoreCase);
    var crudMode = ((ViewData["CrudMode"] as string) ?? requestMode).ToLowerInvariant();
}

@if (Model.Count == 0)
{
    <tr>
        <td colspan="@(isManage ? 4 : 3)" class="text-center py-4 text-muted">Nema trazenih ribara.</td>
    </tr>
}
else
{
    foreach (var user in Model)
    {
        <tr>
            <td class="fw-semibold">@user.Username</td>
            <td>@user.Email</td>
            @if (isManage)
            {
                <td class="text-center">@(user.CatchRecords?.Count ?? 0)</td>
                <td class="text-end">
                    <div class="fb-row-actions">
                        @if (crudMode == "delete")
                        {
                            <a class="btn btn-sm btn-outline-danger" asp-controller="User" asp-action="Delete" asp-route-id="@user.UserID">Obrisi</a>
                        }
                        else
                        {
                            <a class="btn btn-sm btn-outline-secondary" asp-controller="User" asp-action="Edit" asp-route-id="@user.UserID">Uredi</a>
                        }
                    </div>
                </td>
            }
            else
            {
                <td class="text-end">
                    <a class="btn btn-sm btn-outline-primary" asp-controller="User" asp-action="Details" asp-route-id="@user.UserID">Detalji</a>
                </td>
            }
        </tr>
    }
}
