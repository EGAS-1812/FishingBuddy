@model FishingBuddy.Models.UserUpsertViewModel
@{
    ViewData["Title"] = "Uredi ribara";
    ViewData["BreadcrumbItems"] = new List<(string, string?)>
    {
        ("Početna", "/"),
        ("Ribari", "/User"),
        ("Upravljanje", "/User/Manage"),
        ("Uredi ribara", null)
    };
}

<section class="card shadow-sm border-0">
    <div class="card-body">
        @await Html.PartialAsync("_CrudOptionSwitcher", null, new ViewDataDictionary(ViewData)
        {
            ["CrudController"] = "User",
            ["CrudMode"] = "edit"
        })

        <div class="mb-4">
            <h1 class="h2 mb-1">Uredi ribara</h1>
            <p class="text-muted mb-0">Ažurirajte podatke o ribaru.</p>
        </div>

        <form asp-action="Edit" method="post" novalidate>
            <input asp-for="UserID" type="hidden" />
            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 mb-4" role="alert"></div>

            <div class="row g-3">
                <div class="col-12 col-md-6">
                    <label asp-for="Username" class="form-label">Korisničko ime</label>
                    <input asp-for="Username" class="form-control" />
                    <span asp-validation-for="Username" class="text-danger small"></span>
                </div>

                <div class="col-12 col-md-6">
                    <label asp-for="Email" class="form-label">E-mail adresa</label>
                    <input asp-for="Email" class="form-control" type="email" />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <div class="col-12">
                    <div class="form-check form-switch mt-1">
                        <input asp-for="HasFishingLicense" class="form-check-input" role="switch" />
                        <label asp-for="HasFishingLicense" class="form-check-label">Ima ribolovnu dozvolu</label>
                    </div>
                    <span asp-validation-for="HasFishingLicense" class="text-danger small"></span>
                </div>

                <div class="col-12 col-md-6">
                    @await Html.PartialAsync("_DateTimeInput", null, new ViewDataDictionary(ViewData)
                    {
                        ["FieldName"] = nameof(Model.LicenseBeginDate),
                        ["FieldId"] = nameof(Model.LicenseBeginDate),
                        ["Label"] = "Početak dozvole",
                        ["Value"] = Model.LicenseBeginDate,
                        ["Placeholder"] = "dd.mm.yyyy hh:mm"
                    })
                    <span asp-validation-for="LicenseBeginDate" class="text-danger small"></span>
                </div>

                <div class="col-12 col-md-6">
                    @await Html.PartialAsync("_DateTimeInput", null, new ViewDataDictionary(ViewData)
                    {
                        ["FieldName"] = nameof(Model.LicenseExpirationDate),
                        ["FieldId"] = nameof(Model.LicenseExpirationDate),
                        ["Label"] = "Istek dozvole",
                        ["Value"] = Model.LicenseExpirationDate,
                        ["Placeholder"] = "dd.mm.yyyy hh:mm"
                    })
                    <span asp-validation-for="LicenseExpirationDate" class="text-danger small"></span>
                </div>
            </div>

            <div class="d-flex flex-wrap gap-2 mt-4 fb-crud-action-row">
                <button type="submit" class="btn btn-primary">Spremi promjene</button>
                <a class="btn btn-outline-secondary" asp-controller="User" asp-action="Manage">Odustani</a>
            </div>
        </form>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
