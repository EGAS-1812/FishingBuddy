@model IReadOnlyList<FishingBuddy.Models.Bait>
@{
    var isManage = (ViewData["ManageMode"] as bool?) ?? string.Equals(Context.Request.Query["mode"], "manage", StringComparison.OrdinalIgnoreCase);
}

@if (Model.Count == 0)
{
    <tr>
        <td colspan="@(isManage ? 4 : 3)" class="text-center py-4 text-muted">Nema trazenih mamaca.</td>
    </tr>
}
else
{
    foreach (var bait in Model)
    {
        <tr>
            <td class="fw-semibold">@bait.BaitName</td>
            <td><span class="badge bg-primary">@bait.BaitType.GetDisplayName()</span></td>
            @if (isManage)
            {
                <td>@bait.AveragePriceEur.ToString("F2")</td>
                <td class="text-end">
                    <div class="d-inline-flex gap-2">
                        <a class="btn btn-sm btn-outline-secondary" asp-controller="Bait" asp-action="Edit" asp-route-id="@bait.BaitID">Uredi</a>
                        <a class="btn btn-sm btn-outline-danger" asp-controller="Bait" asp-action="Delete" asp-route-id="@bait.BaitID">Obrisi</a>
                    </div>
                </td>
            }
            else
            {
                <td class="text-end">
                    <a class="btn btn-sm btn-outline-primary" asp-controller="Bait" asp-action="Details" asp-route-id="@bait.BaitID">Detalji</a>
                </td>
            }
        </tr>
    }
}
