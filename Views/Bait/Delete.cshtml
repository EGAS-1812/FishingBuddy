@model FishingBuddy.Models.Bait
@{
    ViewData["Title"] = "Obriši mamac";
    ViewData["BreadcrumbItems"] = new List<(string, string?)>
    {
        ("Početna", "/"),
        ("Mamci", "/Bait"),
        ("Upravljanje", "/Bait/Manage"),
        ("Obriši", null)
    };
}

<section class="card shadow-sm border-0">
    <div class="card-body">
        @await Html.PartialAsync("_CrudOptionSwitcher", null, new ViewDataDictionary(ViewData)
        {
            ["CrudController"] = "Bait",
            ["CrudMode"] = "delete"
        })

        <h1 class="h2 mb-1 text-danger">Potvrda brisanja</h1>
        <p class="text-muted mb-4">Jeste li sigurni da želite obrisati ovaj mamac?</p>

        <dl class="row">
            <dt class="col-sm-3">Naziv mamca</dt>
            <dd class="col-sm-9">@Model.BaitName</dd>

            <dt class="col-sm-3">Tip mamca</dt>
            <dd class="col-sm-9">@Model.BaitType.GetDisplayName()</dd>

            <dt class="col-sm-3">Prosječna cijena (€)</dt>
            <dd class="col-sm-9">@Model.AveragePriceEur.ToString("F2")</dd>
        </dl>

        <form asp-action="Delete" method="post">
            <input asp-for="BaitID" type="hidden" />
            @Html.AntiForgeryToken()
            <div class="d-flex flex-wrap gap-2 fb-crud-action-row">
                <button type="submit" class="btn btn-danger">Obriši</button>
                <a class="btn btn-outline-secondary" asp-controller="Bait" asp-action="Manage">Odustani</a>
            </div>
        </form>
    </div>
</section>
