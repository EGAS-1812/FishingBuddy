@model IReadOnlyList<FishingBuddy.Models.Bait>
@{
    ViewData["Title"] = "Mamci";
    ViewData["BreadcrumbItems"] = new List<(string, string?)>
    {
        ("Početna", "/")
    };
}

<section class="card shadow-sm border-0">
    <div class="card-body">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h1 class="h2 mb-0">Mamci</h1>
            <div class="d-flex align-items-center gap-2">
                <div class="dropdown fb-crud-dropdown">
                    <button class="btn btn-outline-dark dropdown-toggle fb-crud-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">CRUD</button>
                    <ul class="dropdown-menu fb-crud-menu">
                        <li><a class="dropdown-item fb-crud-item fb-crud-item--create" asp-controller="Bait" asp-action="Create"><span class="badge bg-success rounded-pill me-2">Create</span></a></li>
                        <li><a class="dropdown-item fb-crud-item fb-crud-item--update" asp-controller="Bait" asp-action="Manage"><span class="badge bg-warning text-dark rounded-pill me-2">Update</span></a></li>
                        <li><a class="dropdown-item fb-crud-item fb-crud-item--delete" asp-controller="Bait" asp-action="Manage"><span class="badge bg-danger rounded-pill me-2">Delete</span></a></li>
                    </ul>
                </div>
                <span class="badge bg-primary">@Model.Count unosa</span>
            </div>
        </div>

        <div class="fb-list-search"
             data-ajax-search
             data-search-endpoint="@Url.Action("Search", "Bait")"
             data-search-mode="index"
             data-empty-colspan="3"
             data-empty-message="Nema trazenih mamaca.">
            <label class="form-label" for="baitSearch">Pretrazi mamce</label>
            <input id="baitSearch" type="search" class="form-control" placeholder="Naziv, tip ili priprema..." data-search-input autocomplete="off" />
            <div class="form-text fb-search-status" data-search-status aria-live="polite">Prikaz svih zapisa.</div>

            <div class="table-responsive">
            <table class="table table-hover table-bordered table-sm align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th scope="col">Naziv</th>
                        <th scope="col">Vrsta</th>
                        <th scope="col" class="text-end">Radnje</th>
                    </tr>
                </thead>
                <tbody data-search-target>
                    @await Html.PartialAsync("_BaitRows", Model, new ViewDataDictionary(ViewData) { ["ManageMode"] = false })
                </tbody>
            </table>
        </div>
        </div>
    </div>
</section>

