@model IReadOnlyList<FishingBuddy.Models.CatchRecord>
@{
    ViewData["Title"] = "Evidencija ulova";
    ViewData["BreadcrumbItems"] = new List<(string, string?)>
    {
        ("Početna", "/")
    };
}

<section class="card shadow-sm border-0">
    <div class="card-body">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-3 fb-page-header">
            <div class="fb-page-mobile-titlebar d-md-none">
                <h1 class="h2 mb-0">Evidencija ulova</h1>
                <div class="dropdown fb-crud-dropdown">
                    <button class="btn btn-outline-dark dropdown-toggle fb-crud-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">CRUD</button>
                    <ul class="dropdown-menu fb-crud-menu">
                        <li><a class="dropdown-item fb-crud-item fb-crud-item--create" asp-controller="CatchRecord" asp-action="Create"><span class="badge bg-success rounded-pill me-2">Create</span></a></li>
                        <li><a class="dropdown-item fb-crud-item fb-crud-item--update" asp-controller="CatchRecord" asp-action="Manage" asp-route-mode="edit"><span class="badge bg-warning text-dark rounded-pill me-2">Update</span></a></li>
                        <li><a class="dropdown-item fb-crud-item fb-crud-item--delete" asp-controller="CatchRecord" asp-action="Manage" asp-route-mode="delete"><span class="badge bg-danger rounded-pill me-2">Delete</span></a></li>
                    </ul>
                </div>
            </div>
            <h1 class="h2 mb-0 d-none d-md-block">Evidencija ulova</h1>
            <div class="d-flex align-items-center gap-2 fb-list-toolbar-actions">
                <div class="dropdown fb-crud-dropdown d-none d-md-block">
                    <button class="btn btn-outline-dark dropdown-toggle fb-crud-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">CRUD</button>
                    <ul class="dropdown-menu fb-crud-menu">
                        <li><a class="dropdown-item fb-crud-item fb-crud-item--create" asp-controller="CatchRecord" asp-action="Create"><span class="badge bg-success rounded-pill me-2">Create</span></a></li>
                        <li><a class="dropdown-item fb-crud-item fb-crud-item--update" asp-controller="CatchRecord" asp-action="Manage" asp-route-mode="edit"><span class="badge bg-warning text-dark rounded-pill me-2">Update</span></a></li>
                        <li><a class="dropdown-item fb-crud-item fb-crud-item--delete" asp-controller="CatchRecord" asp-action="Manage" asp-route-mode="delete"><span class="badge bg-danger rounded-pill me-2">Delete</span></a></li>
                    </ul>
                </div>
                <span class="badge bg-primary">@Model.Count zapisa</span>
            </div>
        </div>

        <div class="fb-list-search"
             data-ajax-search
             data-search-endpoint="@Url.Action("Search", "CatchRecord")"
             data-search-mode="index"
             data-empty-colspan="3"
             data-empty-message="Nema trazenih zapisa o ulovu.">
            <label class="form-label" for="catchSearch">Pretrazi evidenciju</label>
            <input id="catchSearch" type="search" class="form-control" placeholder="Datum, ribar, lokacija..." data-search-input autocomplete="off" />
            <div class="form-text fb-search-status" data-search-status aria-live="polite">Prikaz svih zapisa.</div>

            <div class="table-responsive">
            <table class="table table-hover table-bordered table-sm align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th scope="col">Datum</th>
                        <th scope="col">Ribar</th>
                        <th scope="col" class="text-end">Radnje</th>
                    </tr>
                </thead>
                <tbody data-search-target>
                    @await Html.PartialAsync("_CatchRecordRows", Model, new ViewDataDictionary(ViewData) { ["ManageMode"] = false })
                </tbody>
            </table>
        </div>
        </div>
    </div>
</section>

