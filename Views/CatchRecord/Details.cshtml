@using FishingBuddy.Models
@model FishingBuddy.Models.CatchRecord
@{
    ViewData["Title"] = "Detalji ulova";
    ViewData["BreadcrumbItems"] = new List<(string, string?)>
    {
        ("Početna", "/"),
        ("Evidencija ulova", "/CatchRecord"),
        ("Detalji ulova", null)
    };

    var fish = ViewBag.Fish as Fish;
    var user = ViewBag.User as User;
    var featuredAttachment = ViewBag.FeaturedAttachment as Attachment;
}

<section class="row g-3">
    <div class="col-12 col-xl-7">
        <div class="card fb-white-pill-card fb-catch-details-card shadow-sm border-0 h-100">
            <div class="card-body">
                <h1 class="h2 mb-3">Detalji ulova</h1>
                <dl class="fb-catch-meta-grid mb-0">
                    <div class="fb-catch-meta-item">
                        <dt>Datum ulova</dt>
                        <dd>@Model.CatchDate.ToString("dd.MM.yyyy")</dd>
                    </div>

                    <div class="fb-catch-meta-item">
                        <dt>Ribar</dt>
                        <dd>@(user?.Username ?? "(nepoznato)")</dd>
                    </div>

                    <div class="fb-catch-meta-item">
                        <dt>Riba</dt>
                        <dd>@(fish?.SpeciesName ?? "(nepoznato)")</dd>
                    </div>

                    <div class="fb-catch-meta-item">
                        <dt>Težina</dt>
                        <dd>@Model.Weight.ToString("0.##") kg</dd>
                    </div>

                    <div class="fb-catch-meta-item">
                        <dt>Dužina</dt>
                        <dd>@Model.LengthCm.ToString("0.#") cm</dd>
                    </div>

                    <div class="fb-catch-meta-item">
                        <dt>Lokacija</dt>
                        <dd>@Model.Location</dd>
                    </div>
                </dl>
            </div>
        </div>
    </div>

    <div class="col-12 col-xl-5">
        <div class="card fb-white-pill-card shadow-sm border-0 h-100">
            <div class="card-body">
                <h2 class="h5 mb-3">Slika ulova</h2>

                @if (featuredAttachment != null)
                {
                    <a href="@featuredAttachment.FilePath" target="_blank" rel="noopener noreferrer" class="fb-catch-image-frame d-block">
                        <img src="@featuredAttachment.FilePath"
                             alt="Fotografija ulova: @(fish?.SpeciesName ?? "Riba") od @Model.CatchDate.ToString("dd.MM.yyyy")"
                             class="fb-catch-image-preview"
                             loading="lazy" />
                    </a>
                    <div class="text-muted small mt-2">Kliknite sliku za prikaz u punoj veličini.</div>
                }
                else
                {
                    <div class="alert alert-info py-2 mb-0">Nema dodane slike za ovaj ulov.</div>
                }
            </div>
        </div>
    </div>
</section>

<a class="btn btn-outline-secondary btn-sm" asp-controller="CatchRecord" asp-action="Index">Natrag na popis ulova</a>