@model FishingBuddy.Models.CatchRecord
@using System.Linq
@{
    var userOptions = ViewBag.Users as IEnumerable<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem> ?? Enumerable.Empty<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>();
    var fishOptions = ViewBag.Fish as IEnumerable<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem> ?? Enumerable.Empty<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>();
    var selectedUserLabel = userOptions.FirstOrDefault(x => x.Value == Model.UserID.ToString())?.Text ?? string.Empty;
    var selectedFishLabel = fishOptions.FirstOrDefault(x => x.Value == Model.FishID.ToString())?.Text ?? string.Empty;

    ViewData["Title"] = "Uredi zapis o ulovu";
    ViewData["BreadcrumbItems"] = new List<(string, string?)>
    {
        ("Početna", "/"),
        ("Evidencija ulova", "/CatchRecord"),
        ("Upravljanje", "/CatchRecord/Manage"),
        ("Uredi zapis", null)
    };
}

<section class="card shadow-sm border-0">
    <div class="card-body">
        <div class="mb-4">
            <h1 class="h2 mb-1">Uredi zapis o ulovu</h1>
            <p class="text-muted mb-0">Ažurirajte podatke o zabilježenom ulovu.</p>
        </div>

        <form asp-action="Edit" method="post" novalidate>
            <input asp-for="CatchID" type="hidden" />
            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 mb-4" role="alert"></div>

            <div class="row g-3">
                <div class="col-12 col-md-6">
                    @await Html.PartialAsync("_AutocompleteDropdown", null, new ViewDataDictionary(ViewData)
                    {
                        ["FieldName"] = nameof(Model.UserID),
                        ["FieldId"] = nameof(Model.UserID),
                        ["Label"] = "Ribar",
                        ["Endpoint"] = Url.Action("Autocomplete", "User"),
                        ["SelectedValue"] = Model.UserID.ToString(),
                        ["SelectedLabel"] = selectedUserLabel,
                        ["Placeholder"] = "Upisite ime ribara"
                    })
                    <span asp-validation-for="UserID" class="text-danger small"></span>
                </div>

                <div class="col-12 col-md-6">
                    @await Html.PartialAsync("_AutocompleteDropdown", null, new ViewDataDictionary(ViewData)
                    {
                        ["FieldName"] = nameof(Model.FishID),
                        ["FieldId"] = nameof(Model.FishID),
                        ["Label"] = "Vrsta ribe",
                        ["Endpoint"] = Url.Action("Autocomplete", "Fish"),
                        ["SelectedValue"] = Model.FishID.ToString(),
                        ["SelectedLabel"] = selectedFishLabel,
                        ["Placeholder"] = "Upisite vrstu ribe"
                    })
                    <span asp-validation-for="FishID" class="text-danger small"></span>
                </div>

                <div class="col-12 col-md-6">
                    @await Html.PartialAsync("_DateTimeInput", null, new ViewDataDictionary(ViewData)
                    {
                        ["FieldName"] = nameof(Model.CatchDate),
                        ["FieldId"] = nameof(Model.CatchDate),
                        ["Label"] = "Datum ulova",
                        ["Value"] = Model.CatchDate,
                        ["Placeholder"] = "dd.mm.yyyy hh:mm"
                    })
                    <span asp-validation-for="CatchDate" class="text-danger small"></span>
                </div>

                <div class="col-12 col-md-6">
                    <label asp-for="Location" class="form-label">Lokacija</label>
                    <input asp-for="Location" class="form-control" />
                    <span asp-validation-for="Location" class="text-danger small"></span>
                </div>

                <div class="col-12 col-md-4">
                    <label asp-for="Weight" class="form-label">Težina (kg)</label>
                    <input asp-for="Weight" class="form-control" type="number" step="0.01" min="0" />
                    <span asp-validation-for="Weight" class="text-danger small"></span>
                </div>

                <div class="col-12 col-md-4">
                    <label asp-for="LengthCm" class="form-label">Duljina (cm)</label>
                    <input asp-for="LengthCm" class="form-control" type="number" step="0.1" min="0" />
                    <span asp-validation-for="LengthCm" class="text-danger small"></span>
                </div>
            </div>

            <div class="d-flex flex-wrap gap-2 mt-4">
                <button type="submit" class="btn btn-primary">Spremi promjene</button>
                <a class="btn btn-outline-secondary" asp-controller="CatchRecord" asp-action="Manage">Odustani</a>
            </div>
        </form>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
