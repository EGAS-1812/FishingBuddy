@page
@model LoginModel
@{
    ViewData["Title"] = "Prijava";
}

<section class="card shadow-sm border-0">
    <div class="card-body p-4 p-lg-5">
        <div class="mb-4">
            <h1 class="h2 mb-1">@ViewData["Title"]</h1>
            <p class="text-muted mb-0">Prijavite se u FishingBuddy račun.</p>
        </div>

        <div class="row g-4 align-items-start">
            <div class="col-12 col-xl-7">
                <form id="account" method="post" asp-route-returnUrl="@Model.ReturnUrl" novalidate>
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 mb-4" role="alert"></div>

                    <div class="row g-3">
                        <div class="col-12">
                            <label asp-for="Input.Email" class="form-label"></label>
                            <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="ime@domena.hr" />
                            <span asp-validation-for="Input.Email" class="text-danger small"></span>
                        </div>

                        <div class="col-12">
                            <label asp-for="Input.Password" class="form-label"></label>
                            <input asp-for="Input.Password" class="form-control" autocomplete="current-password" aria-required="true" placeholder="Lozinka" />
                            <span asp-validation-for="Input.Password" class="text-danger small"></span>
                        </div>

                        <div class="col-12">
                            <div class="form-check">
                                <input asp-for="Input.RememberMe" class="form-check-input" />
                                <label asp-for="Input.RememberMe" class="form-check-label"></label>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex flex-wrap gap-2 mt-4">
                        <button id="login-submit" type="submit" class="btn btn-primary">Prijavi se</button>
                        <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl" class="btn btn-outline-secondary">Registriraj se</a>
                        <a asp-page="./ForgotPassword" class="btn btn-link px-0">Zaboravljena lozinka?</a>
                    </div>
                </form>
            </div>

            <div class="col-12 col-xl-5">
                <div class="card h-100 border-0 shadow-sm bg-light">
                    <div class="card-body">
                        <h2 class="h5 mb-3">Prijava putem vanjskog servisa</h2>
                        <p class="text-muted small mb-3">Ako imate račun na vanjskom servisu, prijavite se jednim klikom.</p>

                        @{
                            string? googleProviderName = null;
                            string? facebookProviderName = null;

                            if (Model.ExternalLogins != null)
                            {
                                foreach (var provider in Model.ExternalLogins)
                                {
                                    if (googleProviderName == null &&
                                        (string.Equals(provider.Name, "Google", StringComparison.OrdinalIgnoreCase) ||
                                         string.Equals(provider.DisplayName, "Google", StringComparison.OrdinalIgnoreCase)))
                                    {
                                        googleProviderName = provider.Name;
                                    }

                                    if (facebookProviderName == null &&
                                        (string.Equals(provider.Name, "Facebook", StringComparison.OrdinalIgnoreCase) ||
                                         string.Equals(provider.DisplayName, "Facebook", StringComparison.OrdinalIgnoreCase)))
                                    {
                                        facebookProviderName = provider.Name;
                                    }
                                }
                            }
                        }

                        <form id="external-account" asp-page="./ExternalLogin" asp-route-returnUrl="@Model.ReturnUrl" method="post">
                            <div class="d-flex flex-wrap gap-2">
                                @if (googleProviderName != null)
                                {
                                    <button type="submit" class="btn btn-outline-secondary d-inline-flex align-items-center gap-2" name="provider" value="@googleProviderName" title="Prijava s Google računom">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                                            <path fill="#EA4335" d="M12 10.2v3.9h5.4c-.2 1.3-1.5 3.9-5.4 3.9-3.2 0-5.9-2.7-5.9-6s2.7-6 5.9-6c1.8 0 3.1.8 3.8 1.5l2.6-2.5C16.8 3.6 14.6 2.7 12 2.7 6.9 2.7 2.7 6.9 2.7 12s4.2 9.3 9.3 9.3c5.4 0 9-3.8 9-9.1 0-.6-.1-1.1-.2-1.6H12z"/>
                                            <path fill="#34A853" d="M3.8 7.8l3.2 2.3C7.9 8.1 9.8 6.7 12 6.7c1.8 0 3.1.8 3.8 1.5l2.6-2.5C16.8 3.6 14.6 2.7 12 2.7 8.4 2.7 5.3 4.8 3.8 7.8z"/>
                                            <path fill="#FBBC05" d="M12 21.3c2.5 0 4.6-.8 6.2-2.3l-3-2.4c-.8.5-1.9.9-3.2.9-3.8 0-5.3-2.6-5.5-3.9l-3.3 2.5c1.5 3 4.6 5.2 8.8 5.2z"/>
                                            <path fill="#4285F4" d="M21 12.2c0-.6-.1-1.1-.2-1.6H12v3.9h5.4c-.3 1.3-1.1 2.3-2.2 3l3 2.4c1.8-1.6 2.8-4 2.8-7.7z"/>
                                        </svg>
                                        <span>Google</span>
                                    </button>
                                }
                                else
                                {
                                    <button type="button" class="btn btn-outline-secondary d-inline-flex align-items-center gap-2" disabled title="Google nije konfiguriran">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                                            <path fill="#EA4335" d="M12 10.2v3.9h5.4c-.2 1.3-1.5 3.9-5.4 3.9-3.2 0-5.9-2.7-5.9-6s2.7-6 5.9-6c1.8 0 3.1.8 3.8 1.5l2.6-2.5C16.8 3.6 14.6 2.7 12 2.7 6.9 2.7 2.7 6.9 2.7 12s4.2 9.3 9.3 9.3c5.4 0 9-3.8 9-9.1 0-.6-.1-1.1-.2-1.6H12z"/>
                                            <path fill="#34A853" d="M3.8 7.8l3.2 2.3C7.9 8.1 9.8 6.7 12 6.7c1.8 0 3.1.8 3.8 1.5l2.6-2.5C16.8 3.6 14.6 2.7 12 2.7 8.4 2.7 5.3 4.8 3.8 7.8z"/>
                                            <path fill="#FBBC05" d="M12 21.3c2.5 0 4.6-.8 6.2-2.3l-3-2.4c-.8.5-1.9.9-3.2.9-3.8 0-5.3-2.6-5.5-3.9l-3.3 2.5c1.5 3 4.6 5.2 8.8 5.2z"/>
                                            <path fill="#4285F4" d="M21 12.2c0-.6-.1-1.1-.2-1.6H12v3.9h5.4c-.3 1.3-1.1 2.3-2.2 3l3 2.4c1.8-1.6 2.8-4 2.8-7.7z"/>
                                        </svg>
                                        <span>Google (nije konfiguriran)</span>
                                    </button>
                                }

                                @if (facebookProviderName != null)
                                {
                                    <button type="submit" class="btn btn-outline-secondary d-inline-flex align-items-center gap-2" name="provider" value="@facebookProviderName" title="Prijava s Facebook računom">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                                            <path fill="#1877F2" d="M24 12a12 12 0 1 0-13.9 11.9v-8.4H7.1V12h3V9.4c0-3 1.8-4.7 4.5-4.7 1.3 0 2.6.2 2.6.2v2.9h-1.5c-1.5 0-2 .9-2 1.9V12h3.4l-.5 3.5h-2.9v8.4A12 12 0 0 0 24 12z"/>
                                        </svg>
                                        <span>Facebook</span>
                                    </button>
                                }
                                else
                                {
                                    <button type="button" class="btn btn-outline-secondary d-inline-flex align-items-center gap-2" disabled title="Facebook nije konfiguriran">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                                            <path fill="#1877F2" d="M24 12a12 12 0 1 0-13.9 11.9v-8.4H7.1V12h3V9.4c0-3 1.8-4.7 4.5-4.7 1.3 0 2.6.2 2.6.2v2.9h-1.5c-1.5 0-2 .9-2 1.9V12h3.4l-.5 3.5h-2.9v8.4A12 12 0 0 0 24 12z"/>
                                        </svg>
                                        <span>Facebook (nije konfiguriran)</span>
                                    </button>
                                }
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
